# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 本机根目录，仓库仅保存 paths.example.toml。
/paths.local.toml
/prompts.local.toml

# 本地保留的工作流验收原始证据，不作为产品源码提交。
/.scratch/workflow-file-handoff/evidence/
/.scratch/workflow-nesting/evidence/
/.scratch/chief-bot/evidence/
/.scratch/node-result-approval/evidence/
/.scratch/rust-script-bots/evidence/
/.scratch/node-result-approval/evidence/
/.scratch/cargo-target/
/.scratch/suite-cli-research/evidence/09-pi-resources/
/.scratch/suite-cli-research/evidence/14-initial/

# Python 字节码缓存
__pycache__/
*.py[cod]

# Codebase memory index artifact (regenerated locally)
.codebase-memory/
.omp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust 构建产物
/backend/target
/backend/target-*/

# 前端构建产物：由同一个 Axum 服务提供的打包页面（frontend 执行 npm run build 生成）
/backend/static

# 真实浏览器验收产物
/frontend/test-results/
/frontend/playwright-report/

# 集中运行数据（含临时写入、会话与一次性切换标记）；可由 UI 或手工编辑的定义数据 meta-data 不忽略。
.data/
.manager-zone/

# 旧根目录运行数据仍忽略，首次切换前后均不应被误加入 Git。
# zone 登记列表的旧运行时文件
/zones.json
/zones.json.tmp

# Bot 的旧根目录运行文件与一次性迁移备份（旧路径仍不能入库）
/bot-templates.json
/bot-templates.json.tmp
/*.pre-bot-chat
*.pre-bot-to-task
*.bot-to-task-migration.tmp

# 旧根目录 agent 会话存储
/bot-sessions/


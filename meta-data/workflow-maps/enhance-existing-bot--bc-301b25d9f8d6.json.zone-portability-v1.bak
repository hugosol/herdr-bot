          "output_id": "text"
        },
        {
          "id": "plan_guide_handoff",
          "type": "node",
          "node_id": "w3",
          "output_id": "handoff"
        },
        {
          "id": "node_guide_text",
          "type": "node",
          "node_id": "w4",
          "output_id": "text"
        },
        {
          "id": "node_guide_handoff",
          "type": "node",
          "node_id": "w4",
          "output_id": "handoff"
        }
      ],
      "output_rule": [
        {
          "id": "handoff"
        }
      ],
      "report_policy": "auto",
      "title": "W5 汇总定稿并一次保存 Bot",
      "zone": "E:/Developer/myhub/herdr-bot"

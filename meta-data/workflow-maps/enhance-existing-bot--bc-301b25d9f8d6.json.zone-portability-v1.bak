      "report_policy": "manual",
      "title": "W3 独立修订并确认 Bot.plan_guide",
      "zone": "E:/Developer/myhub/herdr-bot"
    },
    "w4": {
      "blocked_by": [
        "w1"
      ],
      "bot_id": "write-bot-node-guide",
      "input": "修订本次 userInput 指定的既有 Bot.node_guide，按其中明确的修订范围与业务意图，以现有字段为基线。\n命名输入 task_updated 提供已保存的 Task 定稿及确认依据；目标 Bot 必须绑定该 Task，当前完整 Task 配置须与定稿一致。本分支独立形成确认稿，不读取兄弟分支定稿，结果直接交最终汇总。\n本次交付两个独立文件：text 为已确认纯正文；handoff 在标准交接内容外，附完整原 Bot 基线、task_updated 来源地址、完整 Task 定稿及核对结果、完整字段正文和 text 地址。两份正文须逐字一致。",
      "input_rule": [
        {
          "id": "task_updated",
          "type": "node",
          "node_id": "w1",
          "output_id": "handoff"
